# Copy to .env and fill in:  cp .env.example .env

# FCA Register API - free key from https://register.fca.org.uk/Developer/s/
FCA_API_EMAIL=you@example.com
FCA_API_KEY=your-api-key

# Firms to refresh per daily run (least recently checked first)
FCA_FIRM_LIMIT=3000

# Seconds between API calls. The client slows down automatically if the API
# answers 429 (too many requests) and speeds back up afterwards.
FCA_MIN_INTERVAL=0.5
